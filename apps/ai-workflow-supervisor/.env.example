# ---------------------------------------------------------------------------
# AI Workflow Supervisor — configuration
# Copy this file to .env and fill in the values for the providers you use.
# ---------------------------------------------------------------------------

# ---- LLM provider (used for checklist derivation and evaluation) ----------
# One of: anthropic | openai | ollama
SUPERVISOR_LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (or any OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (local, no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- Search provider (only used for needs_verification checklist items) ---
# One of: tavily | brave | serpapi | none
# "none" disables web verification; needs_verification items are evaluated
# from the agent output's own content alone.
SUPERVISOR_SEARCH_PROVIDER=none

TAVILY_API_KEY=
BRAVE_API_KEY=
SERPAPI_API_KEY=

# ---- Pipeline tuning --------------------------------------------------------
# Max checklist items to derive/evaluate per run
SUPERVISOR_MAX_CHECKLIST_ITEMS=20

# Max characters of agent_output sent to the model per evaluation call
SUPERVISOR_MAX_OUTPUT_CHARS=15000

# Max web verifications performed per supervision run (cost/rate-limit guard)
SUPERVISOR_MAX_VERIFICATIONS=8

# Confidence threshold below which a web-verification verdict is treated as
# inconclusive (keeps the output-only status) rather than overriding it
SUPERVISOR_VERIFICATION_THRESHOLD=0.6

# ---- Service configuration (api-py / mcp-server-py) ------------------------
SUPERVISOR_API_HOST=0.0.0.0
SUPERVISOR_API_PORT=8789
