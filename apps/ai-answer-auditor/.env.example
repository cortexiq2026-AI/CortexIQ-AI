# ---------------------------------------------------------------------------
# AI Answer Auditor — configuration
# Copy this file to .env and fill in the values for the providers you use.
# Nothing here is required to have a value from a specific vendor: every
# provider is an interchangeable adapter. Leave a section blank / unset to
# disable that capability (the auditor degrades gracefully).
# ---------------------------------------------------------------------------

# ---- LLM provider (used for claim extraction, classification, judging) ----
# One of: anthropic | openai | ollama
AUDITOR_LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (or any OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (local, no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- Search provider (used for step 4: authoritative-source lookup) -------
# One of: tavily | brave | serpapi | none
# "none" disables web verification; the auditor will only check claims
# against supplied source documents and mark the rest as needs_human_review.
AUDITOR_SEARCH_PROVIDER=none

TAVILY_API_KEY=
BRAVE_API_KEY=
SERPAPI_API_KEY=

# Optional: restrict web verification to a domain allowlist, comma separated.
# Leave blank to allow any domain the search provider returns.
AUDITOR_TRUSTED_DOMAINS=

# ---- Pipeline tuning --------------------------------------------------------
# Max claims to extract per answer (guards against runaway cost on long answers)
AUDITOR_MAX_CLAIMS=40

# Max web searches performed per audit run (cost/rate-limit guard)
AUDITOR_MAX_SEARCHES=10

# Confidence threshold below which a claim verification is escalated to
# needs_human_review instead of being auto-marked supported/contradicted
AUDITOR_HUMAN_REVIEW_THRESHOLD=0.6

# ---- Service configuration (api-py / mcp-server-py) ------------------------
AUDITOR_API_HOST=0.0.0.0
AUDITOR_API_PORT=8787
