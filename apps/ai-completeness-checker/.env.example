# ---------------------------------------------------------------------------
# AI Completeness Checker — configuration
# Copy this file to .env and fill in the values for the provider you use.
# ---------------------------------------------------------------------------

# ---- LLM provider (used for topic derivation and coverage analysis) -------
# One of: anthropic | openai | ollama
CHECKER_LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# OpenAI (or any OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Ollama (local, no API key needed — useful for sensitive documents like
# contracts or internal architecture docs you don't want sent to a
# third-party API)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- Pipeline tuning --------------------------------------------------------
# Max topics to derive/check per run (guards against runaway cost)
CHECKER_MAX_TOPICS=25

# Max characters of the document sent to the model per analysis call
CHECKER_MAX_DOCUMENT_CHARS=12000

# ---- Service configuration (api-py / mcp-server-py) ------------------------
CHECKER_API_HOST=0.0.0.0
CHECKER_API_PORT=8788
